{
  "name": "practica-e2e-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Suite end-to-end de Playwright para la tienda Café de Altura",
  "type": "module",
  "scripts": {
    "tienda": "serve tienda -l 4173",
    "test": "playwright test --project=chromium",
    "test:ui": "playwright test --project=chromium --ui",
    "test:todos-navegadores": "playwright test --project=chromium --project=firefox --project=webkit",
    "reporte": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "22.18.0",
    "serve": "14.2.4",
    "typescript": "5.9.2"
  }
}
